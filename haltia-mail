    # Signing in

    def build_signin(self):
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        column.get_style_context().add_class("signin")
        # Narrow enough for the tablet upright (800 px) with the margins.
        column.set_size_request(640, -1)
        column.set_halign(Gtk.Align.CENTER)
        column.set_margin_top(32)
        column.set_margin_bottom(32)
        column.set_margin_start(24)
        column.set_margin_end(24)

        self.address = Gtk.Entry(input_purpose=Gtk.InputPurpose.EMAIL)
        self.address.connect("changed", lambda *_a: self.domain_changed())
        self.password = Gtk.Entry(input_purpose=Gtk.InputPurpose.PASSWORD, visibility=False)
        self.password.connect("activate", lambda *_a: self.check())
        self.server = Gtk.Entry()
        self.server.set_placeholder_text("imap.example.org")
        self.server_label = label("Сервер")
        self.hint = label("", "hint", wrap=True)
        self.hint.set_selectable(True)
        self.check_btn = Gtk.Button(label="Проверить")
        self.check_btn.get_style_context().add_class("suggested-action")
        self.check_btn.connect("clicked", lambda *_a: self.check())
        self.signin_status = label("", "status", wrap=True)
        self.server_reply = label("", "reply", wrap=True)
        self.server_reply.set_selectable(True)

        for widget in (label("Адрес почты"), self.address, label("Пароль приложения"),
                       self.password, self.server_label, self.server, self.hint,
                       self.check_btn, self.signin_status, self.server_reply):
            column.pack_start(widget, False, False, 0)
        for widget in (self.server_label, self.server):
            widget.set_no_show_all(True)
        self.address.set_text(self.config.get("mail", "address", fallback=""))
        self.domain_changed()

        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.add(column)
        return scroll

    def domain_changed(self):
        address = self.address.get_text()
        known = servers.servers(address)
        other = known is None and bool(servers.domain(address))
        for widget in (self.server_label, self.server):
            widget.set_visible(other)
        if other and not self.server.get_text():
            saved = self.config.get("mail", "imap", fallback="")
            self.server.set_text(saved or servers.guess_field(address))
        if known:
            self.hint.set_text(known.hint)
        else:
            self.hint.set_text(servers.OTHER_HINT if other else servers.APP_HINT)

    def check(self):
        address = self.address.get_text().strip()
        password = self.password.get_text().strip().replace(" ", "")
        if not servers.domain(address):
            self.signin_status.set_text("Введите адрес почты целиком, например ivan@yandex.ru.")
            self.server_reply.set_text("")
            return
        if not password:
            self.signin_status.set_text("Введите пароль приложения.")
            self.server_reply.set_text("")
            return
        provider = servers.servers(address) or servers.from_field(self.server.get_text())
        if provider is None:
            self.signin_status.set_text("Укажите сервер, например imap.example.org.")
            self.server_reply.set_text("")
            return
        self.check_btn.set_sensitive(False)
        self.signin_status.set_text("Проверяю…")
        self.server_reply.set_text("")
        box = Mailbox(address, password, provider.imap, CACHE)

        def work():
            box.check()
            self.vault.put(SECRET, password)
            return box

        def done(box):
            self.check_btn.set_sensitive(True)
            self.password.set_text("")
            self.signin_status.set_text("")
            self.server_reply.set_text("")
            section = self.config["mail"]
            section["address"] = address
            section["imap"] = "%s:%d" % provider.imap
            section["smtp"] = "%s:%d" % provider.smtp
            try:
                write_config(self.config)
            except OSError:
                pass
            self.opened(box, provider.smtp)

        def failed(e):
            self.check_btn.set_sensitive(True)
            self.show_login_failed(e)
            box.close()

        self.worker.do(work, done, failed)

    def show_login_failed(self, e, status=True):
        """The sign-in page: the friendly line, the server's words in grey,
        a line in kit's log. Never the password."""
        if status:
            self.signin_status.set_text(error_text(e))
        reply = page_reply(e)
        self.server_reply.set_text(reply)
        if reply:
            log_line("IMAP login failed: %s" % reply)

    def start(self):
        """The saved mailbox, if the vault keeps its password; else signing in."""
        section = self.config["mail"]
        address, imap = section.get("address", ""), section.get("imap", "")
        provider = servers.servers(address) or servers.from_field(imap)
        if not address or provider is None:
            self.show("signin")
            return

        def failed(e):
            self.show_login_failed(e)
            self.show("signin")

        def done(password):
            if not password:
                self.show("signin")
                return
            self.opened(Mailbox(address, password, provider.imap, CACHE), provider.smtp)

        self.worker.do(lambda: self.vault.get(SECRET), done, failed)

    def opened(self, box, smtp_server):
        self.live = True
        self.box = box
        self.smtp_server = smtp_server
        self.role = INBOX
        self.folder_buttons[INBOX].set_active(True)
        self.show("list")
        self.load(0)
        if self.attached:   # files shared before signing in
            self.show("compose")

    def sign_out(self):
        address = self.box.address if self.box else ""
        question = ("Выйти из почты %s? Пароль приложения будет удалён, письма на "
                    "сервере останутся." % address)
        if self.waiting:
            question += " Неотправленные письма из «Исходящих» тоже удалятся."
        if not dialogs.ask(self.window, question, "Выйти"):
            return
        box, self.box = self.box, None
        self.gen += 1
        self.live = False
        self.clear_list()
        self.clear_compose()
        # On the GTK thread, before the worker job: a flush already running
        # sees the stamp and does not send a letter «Выйти» dropped.
        self.outbox.clear()

        def work():
            if box is not None:
                box.close()
            self.vault.drop(SECRET)
            safe = re.sub(r"[^\w.@-]", "_", address.lower())
            if safe:
                shutil.rmtree(os.path.join(CACHE, safe), ignore_errors=True)
            shutil.rmtree(os.path.join(CACHE, "files"), ignore_errors=True)

        self.waiting_changed(0)
        self.worker.do(work, lambda _r: None,
                       lambda e: dialogs.info(self.window, error_text(e)))
        self.signin_status.set_text("")
        self.server_reply.set_text("")
        self.show("signin")

    # The list

    def build_list(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        folders = Gtk.Box(spacing=0, homogeneous=True)
        folders.get_style_context().add_class("folders")
        folders.get_style_context().add_class("linked")
        self.folder_buttons = {}
        group = None
        for role in (INBOX, SENT, TRASH):
            button = Gtk.RadioButton.new_with_label_from_widget(group, NAMES[role])
            button.set_mode(False)
            button.connect("toggled", self.folder_toggled, role)
            group = group or button
            self.folder_buttons[role] = button
            folders.pack_start(button, True, True, 0)
        page.pack_start(folders, False, False, 0)
        self.list_status = label("", "status", xalign=0.5, wrap=True)
        self.list_status.set_no_show_all(True)
        page.pack_start(self.list_status, False, False, 8)

        self.rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.rows.connect("row-activated", lambda _l, row: self.open_letter(row))
        self.placeholder = label("", "status", xalign=0.5)
        self.placeholder.show()
        self.rows.set_placeholder(self.placeholder)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        scroll.add(self.rows)
        scroll.connect("edge-reached", self.edge_reached)
        self.list_scroll = scroll
        page.pack_start(scroll, True, True, 0)
        return page

    def folder_toggled(self, button, role):
        if button.get_active() and role != self.role:
            self.role = role
            self.show("list")
            self.load(0)

    def clear_list(self):
        for row in self.rows.get_children():
            self.rows.remove(row)
        self.loaded = self.total = 0

    def set_status(self, text):
        self.list_status.set_text(text)
        self.list_status.set_visible(bool(text))

    def load(self, start):
        """The page from start on; start 0 reloads the folder (showing the
        cached lines first)."""
        if self.box is None or (self.loading and start):
            return
        box, role = self.box, self.role
        if start == 0:
            self.gen += 1
            self.clear_list()
            self.placeholder.set_text("Загружаю…")
            self.set_status("")
            gen = self.gen
            self.worker.do(lambda: box.cached(role, PAGE),
                           lambda lines: self.cached(gen, lines))
        gen = self.gen
        self.loading = True
        self.worker.do(lambda: box.page(role, start, PAGE),
                       lambda answer: self.loaded_page(gen, start, *answer),
                       lambda e: self.load_failed(gen, e))

    def cached(self, gen, lines):
        if gen == self.gen and not self.rows.get_children():
            for line in lines:
                self.rows.add(Row(line))
            self.rows.show_all()

    def loaded_page(self, gen, start, lines, total):
        if gen != self.gen:
            return
        self.loading = False
        if start == 0:
            self.clear_list()
        for line in lines:
            self.rows.add(Row(line))
        self.rows.show_all()
        self.loaded, self.total = start + len(lines), total
        self.placeholder.set_text("Писем нет")
        self.set_status("")

    def load_failed(self, gen, e):
        if gen != self.gen:
            return
        self.loading = False
        if isinstance(e, LoginFailed):
            self.box = None
            self.signin_status.set_text(
                "Почта больше не принимает пароль. Введите новый пароль приложения.")
            self.show_login_failed(e, status=False)
            self.show("signin")
            return
        self.placeholder.set_text("")
        self.set_status(error_text(e) + " Нажмите «⟳», чтобы попробовать снова.")

    def edge_reached(self, _scroll, position):
        if position == Gtk.PositionType.BOTTOM and self.loaded < self.total:
            self.load(self.loaded)

    # A letter

    def build_letter(self):
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for side in ("top", "bottom", "start", "end"):
            getattr(column, "set_margin_" + side)(24)
        self.letter_subject = label("", "letter-subject", wrap=True)
        self.letter_from = label("", "letter-head", wrap=True)
        self.letter_when = label("", "letter-head")
        self.files = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.files.get_style_context().add_class("files")
        self.text = Gtk.TextView(editable=False, cursor_visible=False,
                                 wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.text.get_style_context().add_class("letter-text")
        self.text.set_top_margin(16)
        self.text.set_bottom_margin(16)
        buffer = self.text.get_buffer()
        self.link_tag = buffer.create_tag("link", underline=Pango.Underline.SINGLE,
                                          foreground="#1a5fb4")
        self.text.connect("button-release-event", self.text_tapped)
        self.trash_btn = Gtk.Button(label="В корзину")
        self.trash_btn.get_style_context().add_class("trash")
        self.trash_btn.set_halign(Gtk.Align.START)
        self.trash_btn.connect("clicked", lambda *_a: self.to_trash())
        for widget in (self.letter_subject, self.letter_from, self.letter_when, self.files,
                       self.text):
            column.pack_start(widget, False, False, 0)
        column.pack_start(self.trash_btn, False, False, 16)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.add(column)
        self.letter_scroll = scroll
        return scroll

    def open_letter(self, row):
        uid, role, box = row.line.uid, self.role, self.box
        if box is None:
            return
        self.letter_uid = uid
        self.letter = None
        self.letter_subject.set_text(row.line.subject)
        self.letter_from.set_text(row.line.sender)
        self.letter_when.set_text(nice_when(row.line.when, full=True))
        for child in self.files.get_children():
            self.files.remove(child)
        self.text.get_buffer().set_text("Открываю…")
        self.trash_btn.set_visible(False)
        self.letter_scroll.get_vadjustment().set_value(0)
        self.show("letter")

        def done(letter):
            row.set_unread(False)
            if self.letter_uid == uid:
                self.show_letter(letter, role)

        def failed(e):
            if self.letter_uid == uid:
                self.text.get_buffer().set_text(error_text(e))

        self.worker.do(lambda: box.read(role, uid), done, failed)

    def show_letter(self, letter, role):
        self.letter = letter
        self.letter_subject.set_text(letter.subject)
        head = letter.sender
        if role == SENT and letter.to:
            head = "Кому: " + letter.to
        self.letter_from.set_text(head)
        if letter.when:
            self.letter_when.set_text(nice_when(letter.when, full=True))
        for attachment in letter.attachments:
            self.files.pack_start(self.file_row(attachment), False, False, 0)
        self.files.show_all()
        buffer = self.text.get_buffer()
        buffer.set_text(letter.text or "(письмо без текста)")
        for match in LINK.finditer(letter.text):
            end = match.end() - len(match.group(0)) + len(match.group(0).rstrip(".,;:!?'"))
            buffer.apply_tag(self.link_tag, buffer.get_iter_at_offset(match.start()),
                             buffer.get_iter_at_offset(end))
        self.trash_btn.set_visible(role != TRASH)

    def text_tapped(self, view, event):
        buffer = view.get_buffer()
        if buffer.get_has_selection():
            return False
        x, y = view.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, int(event.x), int(event.y))
        found, where = view.get_iter_at_location(x, y)
        if not found or not where.has_tag(self.link_tag):
            return False
        start, end = where.copy(), where.copy()
        if not start.starts_tag(self.link_tag):
            start.backward_to_tag_toggle(self.link_tag)
        end.forward_to_tag_toggle(self.link_tag)
        uri = buffer.get_text(start, end, False)
        try:
            Gtk.show_uri_on_window(self.window, uri, Gdk.CURRENT_TIME)
        except GLib.Error:
            dialogs.info(self.window, "Не удалось открыть ссылку.")
        return False

    def file_row(self, attachment):
        row = Gtk.Box(spacing=12)
        name = label("%s · %s" % (attachment.name, nice_size(attachment.size)),
                     ellipsize=True)
        name.set_hexpand(True)
        row.pack_start(name, True, True, 0)
        for title, action in (("Открыть", self.open_file), ("Сохранить", self.save_file),
                              ("Отправить", self.send_file)):
            button = Gtk.Button(label=title)
            button.connect("clicked", lambda _b, act=action: act(attachment))
            row.pack_start(button, False, False, 0)
        return row

    def temp_file(self, name, data):
        """The bytes as a file of its own folder (only we can read it), so
        files with the same name do not meet."""
        folder = os.path.join(CACHE, "files")
        os.makedirs(folder, mode=0o700, exist_ok=True)
        folder = tempfile.mkdtemp(dir=folder)
        path = os.path.join(folder, name)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        return path

    def open_file(self, attachment):
        try:
            path = self.temp_file(attachment.name, attachment.data)
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(path).get_uri(), None)
        except (OSError, GLib.Error):
            dialogs.info(self.window, "Нет программы, которая открывает такие файлы.")

    def save_file(self, attachment):
        folder = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) \
            or GLib.get_home_dir()
        try:
            os.makedirs(folder, exist_ok=True)
            path = unique(folder, attachment.name)
            with open(path, "xb") as f:
                f.write(attachment.data)
        except OSError:
            dialogs.info(self.window, "Не удалось сохранить файл.")
            return
        dialogs.info(self.window, "Файл «%s» сохранён в папке «%s»."
                     % (os.path.basename(path), os.path.basename(folder)))

    def send_file(self, attachment):
        try:
            path = self.temp_file(attachment.name, attachment.data)
        except OSError:
            dialogs.info(self.window, "Не удалось подготовить файл.")
            return
        share.send(path, self.window)

    def to_trash(self):
        uid, role, box = self.letter_uid, self.role, self.box
        if box is None or uid is None or role == TRASH:
            return
        self.trash_btn.set_sensitive(False)

        def done(_result):
            self.trash_btn.set_sensitive(True)
            for row in self.rows.get_children():
                if row.line.uid == uid:
                    self.rows.remove(row)
                    self.loaded -= 1
                    self.total -= 1
            if self.letter_uid == uid:
                self.go_back()

        def failed(e):
            self.trash_btn.set_sensitive(True)
            dialogs.info(self.window, error_text(e))

        self.worker.do(lambda: box.trash(role, uid), done, failed)

    # A new letter

    def build_compose(self):
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        column.get_style_context().add_class("compose")
        for side in ("top", "bottom", "start", "end"):
            getattr(column, "set_margin_" + side)(24)
        self.to = Gtk.Entry(input_purpose=Gtk.InputPurpose.EMAIL)
        self.to.set_placeholder_text("ivan@yandex.ru")
        self.subject = Gtk.Entry()
        self.to.connect("activate", lambda *_a: self.subject.grab_focus())
        self.body = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.body.get_style_context().add_class("letter-text")
        for side in ("top", "bottom", "left", "right"):
            getattr(self.body, "set_%s_margin" % side)(12)
        self.body.set_size_request(-1, 240)
        frame = Gtk.Frame()
        frame.add(self.body)
        self.attached_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.attached_box.get_style_context().add_class("files")
        buttons = Gtk.Box(spacing=12)
        attach = Gtk.Button(label="Прикрепить")
        attach.connect("clicked", lambda *_a: self.choose_files())
        self.send_btn = Gtk.Button(label="Отправить")
        self.send_btn.get_style_context().add_class("suggested-action")
        self.send_btn.connect("clicked", lambda *_a: self.send())
        buttons.pack_start(attach, False, False, 0)
        buttons.pack_end(self.send_btn, False, False, 0)
        self.compose_status = label("", "status", wrap=True)
        for widget in (label("Кому"), self.to, label("Тема"), self.subject, label("Текст"),
                       frame, self.attached_box, buttons, self.compose_status):
            column.pack_start(widget, False, False, 0)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.add(column)
        return scroll

    def choose_files(self):
        chooser = Gtk.FileChooserNative.new("Прикрепить файлы", self.window,
                                            Gtk.FileChooserAction.OPEN, "Прикрепить", "Отмена")
        chooser.set_select_multiple(True)
        if chooser.run() == Gtk.ResponseType.ACCEPT:
            for gfile in chooser.get_files():
                self.attach(gfile)
        chooser.destroy()

    def attach(self, gfile):
        """A copy of the file goes with the letter: the program that shared it
        may delete its own at once."""
        name = clean_name(gfile.get_basename() or "") or "файл"
        try:
            _ok, data, _etag = gfile.load_contents(None)
            path = self.temp_file(name, data)
        except (GLib.Error, OSError):
            dialogs.info(self.window, "Не удалось прикрепить файл «%s»." % name)
            return
        self.attached.append((name, path, len(data)))
        self.show_attached()

    def show_attached(self):
        for child in self.attached_box.get_children():
            self.attached_box.remove(child)
        for item in self.attached:
            row = Gtk.Box(spacing=12)
            name = label("%s · %s" % (item[0], nice_size(item[2])), ellipsize=True)
            name.set_hexpand(True)
            remove = Gtk.Button(label="Убрать")
            remove.connect("clicked", lambda _b, it=item: self.detach(it))
            row.pack_start(name, True, True, 0)
            row.pack_start(remove, False, False, 0)
            self.attached_box.pack_start(row, False, False, 0)
        self.attached_box.show_all()

    def detach(self, item):
        if item in self.attached:
            self.attached.remove(item)
            shutil.rmtree(os.path.dirname(item[1]), ignore_errors=True)
            self.show_attached()

    def clear_compose(self):
        for item in list(self.attached):
            self.detach(item)
        self.to.set_text("")
        self.subject.set_text("")
        self.body.get_buffer().set_text("")
        self.compose_status.set_text("")

    def send(self):
        box, server = self.box, self.smtp_server
        if box is None or server is None:
            return
        to = self.to.get_text().strip()
        try:
            if not smtp.recipients(to):
                self.compose_status.set_text("Укажите, кому письмо: адрес почты.")
                return
        except ValueError as e:
            self.compose_status.set_text("Проверьте адрес «%s»." % e)
            return
        subject = self.subject.get_text().strip()
        buffer = self.body.get_buffer()
        text = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), False)
        files = list(self.attached)
        self.send_btn.set_sensitive(False)
        self.compose_status.set_text("Отправляю…")

        def work():
            data = []
            for name, path, _size in files:
                with open(path, "rb") as f:
                    data.append((name, f.read()))
            msg = smtp.make(box.address, to, subject, text, data)
            missed = ""
            try:
                raw = smtp.send(box.address, box.password, server, msg)
            except smtp.Refused as e:
                if e.raw is None:
                    raise
                raw, missed = e.raw, str(e)
            try:
                saved = box.save_sent(raw, msg["Message-ID"])
            except Exception:  # noqa: BLE001 - the letter went all the same
                saved = False
            return saved, missed

        def done(answer):
            saved, missed = answer
            self.send_btn.set_sensitive(True)
            self.clear_compose()
            self.show("list")
            if self.role == SENT:
                self.load(0)
            text = "Письмо отправлено."
            if missed:
                text += " Не дошло до: %s." % missed
            if not saved:
                text += " В «Отправленные» его положить не удалось."
            dialogs.info(self.window, text)

        def failed(e):
            self.send_btn.set_sensitive(True)
            self.compose_status.set_text(error_text(e))

        self.worker.do(work, done, failed)


if __name__ == "__main__":

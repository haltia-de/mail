def later(fn, *args):
    """fn(*args) on the GTK thread, once."""
    def call():
        fn(*args)
        return False
    GLib.idle_add(call)


class Worker:
    """One thread for IMAP: imaplib is not thread-safe, and jobs keep their order."""

    def __init__(self):
        self.jobs = queue.Queue()
        threading.Thread(target=self.run, daemon=True).start()

    def do(self, work, done=None, failed=None):
        self.jobs.put((work, done, failed))

    def run(self):
        while True:
            work, done, failed = self.jobs.get()
            try:
                result = work()
            except Exception as e:  # noqa: BLE001 - shown to the person
                if failed:
                    later(failed, e)
            else:
                if done:
                    later(done, result)


def nice_when(when, full=False):
    if when is None:
        return ""
    local = when.astimezone()
    today = datetime.now().astimezone().date()
    clock = local.strftime("%H:%M")
    if full:
        return "%d %s %d, %s" % (local.day, MONTHS[local.month - 1], local.year, clock)
    if local.date() == today:
        return clock
    if local.date() == today - timedelta(days=1):
        return "вчера"
    short = "%d %s" % (local.day, MONTHS[local.month - 1][:3])
    return short if local.year == today.year else "%s %d" % (short, local.year)


def nice_size(size):
    if size < 1024:
        return "%d Б" % size
    if size < 1024 * 1024:
        return "%d КБ" % round(size / 1024)
    return ("%.1f МБ" % (size / 1024 / 1024)).replace(".", ",")


def error_text(e):
    if isinstance(e, LoginFailed):
        return "Почта не приняла адрес или пароль. Нужен пароль приложения, а не обычный."
    if isinstance(e, Locked):
        return "Связка ключей закрыта, пароль не прочитать."
    if isinstance(e, KeyError):
        return "На сервере нет этой папки."
    if isinstance(e, OSError):
        return "Нет связи с сервером почты."
    return "Ошибка почты: %s" % e


def label(text="", css=None, xalign=0.0, wrap=False, ellipsize=False):
    widget = Gtk.Label(label=text, xalign=xalign)
    if css:
        for name in css.split():
            widget.get_style_context().add_class(name)
    if wrap:
        widget.set_line_wrap(True)
        widget.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if ellipsize:
        widget.set_ellipsize(Pango.EllipsizeMode.END)
    return widget


def read_config():
    config = configparser.ConfigParser()
    config.read(CONFIG, encoding="utf-8")
    if not config.has_section("mail"):
        config.add_section("mail")
    return config


def write_config(config):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    new = CONFIG + ".new"
    with open(new, "w", encoding="utf-8") as f:
        config.write(f)
    os.replace(new, CONFIG)


def unique(folder, name):
    stem, dot, ext = name.rpartition(".")
    if not stem:
        stem, dot, ext = name, "", ""
    path, n = os.path.join(folder, name), 1
    while os.path.exists(path):
        n += 1
        path = os.path.join(folder, "%s (%d)%s%s" % (stem, n, dot, ext))
    return path


class Row(Gtk.ListBoxRow):
    def __init__(self, line):
        super().__init__()
        self.line = line
        self.get_style_context().add_class("mail-row")
        grid = Gtk.Grid(column_spacing=16, row_spacing=4)
        self.sender = label(line.sender, "from", ellipsize=True)
        self.sender.set_hexpand(True)
        self.subject = label(line.subject, "subject", ellipsize=True)
        when = label(nice_when(line.when), "when", xalign=1.0)
        grid.attach(self.sender, 0, 0, 1, 1)
        grid.attach(when, 1, 0, 1, 1)
        grid.attach(self.subject, 0, 1, 2, 1)
        self.add(grid)
        self.set_unread(line.unread)

    def set_unread(self, unread):
        self.line = self.line._replace(unread=unread)
        for widget in (self.sender, self.subject):
            context = widget.get_style_context()
            (context.add_class if unread else context.remove_class)("unread")


class Mail(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.window = None
        self.dbus_id = None
        self.retry = None
        self.flushing = False
        # Started by D-Bus (--gapplication-service): wait this long for calls.
        self.set_inactivity_timeout(10000)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.back = Gio.SimpleAction.new("back", None)
        self.back.connect("activate", lambda *_a: self.go_back())
        self.back.set_enabled(False)
        self.add_action(self.back)
        self.set_accels_for_action("app.back", ["<Alt>Left", "Escape"])
        # One worker for IMAP, SMTP and the vault, with or without a window.
        self.worker = Worker()
        self.vault = Vault(APP_ID, FOLDER, label="Почта")
        self.outbox = outbox.Outbox(OUTBOX)
        Gio.NetworkMonitor.get_default().connect(
            "network-changed", lambda _m, available: available and self.flush())
        self.flush()

    def do_dbus_register(self, connection, path):
        if not Gtk.Application.do_dbus_register(self, connection, path):
            return False
        info = Gio.DBusNodeInfo.new_for_xml(INTERFACE).interfaces[0]
        self.dbus_id = connection.register_object(path, info, self.dbus_call, None, None)
        return True

    def do_dbus_unregister(self, connection, path):
        if self.dbus_id is not None:
            connection.unregister_object(self.dbus_id)
            self.dbus_id = None
        Gtk.Application.do_dbus_unregister(self, connection, path)

    def do_activate(self):
        if self.window is None:
            self.build()
            self.start()
        self.window.present()

    # The window

    def build(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.config = read_config()
        self.box = None
        self.role = INBOX
        self.gen = 0
        self.loaded = self.total = 0
        self.loading = False
        self.letter = None
        self.letter_uid = None

        window = Gtk.ApplicationWindow(application=self, title="Почта")
        window.set_default_size(1280, 800)
        window.set_icon_name(APP_ID)
        self.window = window

        header = Gtk.HeaderBar()
        # The Haltia shell closes windows with its own button; any other
        # desktop gets the usual window buttons in the header.
        header.set_show_close_button(not ON_HALTIA)
        self.title = label("Почта", "title", xalign=0.5)
        header.set_custom_title(self.title)
        back = Gtk.Button(label="←")
        back.set_action_name("app.back")
        back.set_no_show_all(True)
        # Seen only while there is a step back; else the shell's «⇤» takes one home.
        self.back.bind_property("enabled", back, "visible", GObject.BindingFlags.SYNC_CREATE)
        header.pack_start(back)
        self.leave = Gtk.Button(label="Выйти")
        self.leave.connect("clicked", lambda *_a: self.sign_out())
        self.refresh = Gtk.Button(label="⟳")
        self.refresh.set_tooltip_text("Обновить")
        self.refresh.connect("clicked", lambda *_a: self.load(0))
        header.pack_end(self.leave)
        header.pack_end(self.refresh)
        window.set_titlebar(header)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.add_named(self.build_signin(), "signin")
        self.stack.add_named(self.build_list(), "list")
        self.stack.add_named(self.build_letter(), "letter")
        self.stack.add_named(label("", xalign=0.5), "wait")
        window.add(self.stack)
        window.show_all()
        self.show("wait")

    def show(self, page):
        self.stack.set_visible_child_name(page)
        self.back.set_enabled(page == "letter")
        self.leave.set_visible(page == "list")
        self.refresh.set_visible(page == "list")
        self.title.set_text({"list": NAMES[self.role], "letter": "Письмо"}.get(page, "Почта"))

    def go_back(self):
        if self.stack.get_visible_child_name() == "letter":
            self.letter_uid = None
            self.show("list")


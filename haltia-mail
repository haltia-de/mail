def later(fn, *args):
    """fn(*args) on the GTK thread, once."""
    def call():
        fn(*args)
        return False
    GLib.idle_add(call)


class Worker:
    """One thread for IMAP: imaplib is not thread-safe, and jobs keep their order."""

    def __init__(self):
        self.jobs = queue.Queue()
        threading.Thread(target=self.run, daemon=True).start()

    def do(self, work, done=None, failed=None):
        self.jobs.put((work, done, failed))

    def run(self):
        while True:
            work, done, failed = self.jobs.get()
            try:
                result = work()
            except Exception as e:  # noqa: BLE001 - shown to the person
                if failed:
                    later(failed, e)
            else:
                if done:
                    later(done, result)


def nice_when(when, full=False):
    if when is None:
        return ""
    local = when.astimezone()
    today = datetime.now().astimezone().date()
    clock = local.strftime("%H:%M")
    if full:
        return "%d %s %d, %s" % (local.day, MONTHS[local.month - 1], local.year, clock)
    if local.date() == today:
        return clock
    if local.date() == today - timedelta(days=1):
        return "вчера"
    short = "%d %s" % (local.day, MONTHS[local.month - 1][:3])
    return short if local.year == today.year else "%s %d" % (short, local.year)


def nice_size(size):
    if size < 1024:
        return "%d Б" % size
    if size < 1024 * 1024:
        return "%d КБ" % round(size / 1024)
    return ("%.1f МБ" % (size / 1024 / 1024)).replace(".", ",")


def log_line(text):
    """One line in kit's log; GLib's log when kit has no log.line."""
    if kit_log is not None and hasattr(kit_log, "line"):
        kit_log.line(text)
        return
    GLib.log(APP_ID, GLib.LogLevelFlags.LEVEL_WARNING, "%s", text)


def error_text(e):
    if isinstance(e, LoginFailed):
        return "Почта не приняла адрес или пароль."
    if isinstance(e, smtp.Refused):
        return "Сервер не принял письмо: %s" % e
    if isinstance(e, Locked):
        return "Связка ключей закрыта, пароль не прочитать."
    if isinstance(e, KeyError):
        return "На сервере нет этой папки."
    if isinstance(e, OSError):
        return "Нет связи с сервером почты."
    return "Ошибка почты: %s" % e


def label(text="", css=None, xalign=0.0, wrap=False, ellipsize=False):
    widget = Gtk.Label(label=text, xalign=xalign)
    if css:
        for name in css.split():
            widget.get_style_context().add_class(name)
    if wrap:
        widget.set_line_wrap(True)
        widget.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if ellipsize:
        widget.set_ellipsize(Pango.EllipsizeMode.END)
    return widget


def read_config():
    config = configparser.ConfigParser()
    config.read(CONFIG, encoding="utf-8")
    if not config.has_section("mail"):
        config.add_section("mail")
    return config


def write_config(config):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    new = CONFIG + ".new"
    with open(new, "w", encoding="utf-8") as f:
        config.write(f)
    os.replace(new, CONFIG)


def unique(folder, name):
    stem, dot, ext = name.rpartition(".")
    if not stem:
        stem, dot, ext = name, "", ""
    path, n = os.path.join(folder, name), 1
    while os.path.exists(path):
        n += 1
        path = os.path.join(folder, "%s (%d)%s%s" % (stem, n, dot, ext))
    return path


class Row(Gtk.ListBoxRow):
    def __init__(self, line):
        super().__init__()
        self.line = line
        self.get_style_context().add_class("mail-row")
        grid = Gtk.Grid(column_spacing=16, row_spacing=4)
        self.sender = label(line.sender, "from", ellipsize=True)
        self.sender.set_hexpand(True)
        self.subject = label(line.subject, "subject", ellipsize=True)
        when = label(nice_when(line.when), "when", xalign=1.0)
        grid.attach(self.sender, 0, 0, 1, 1)
        grid.attach(when, 1, 0, 1, 1)
        grid.attach(self.subject, 0, 1, 2, 1)
        self.add(grid)
        self.set_unread(line.unread)

    def set_unread(self, unread):
        self.line = self.line._replace(unread=unread)
        for widget in (self.sender, self.subject):
            context = widget.get_style_context()
            (context.add_class if unread else context.remove_class)("unread")


class Mail(Gtk.Application):
    def __init__(self):
        # Files shared from other programs come as «open»: a new letter with them.
        # D-Bus starts it with --gapplication-service: no window, only Send.
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.window = None
        self.box = None
        self.dbus_ids = []

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.back = Gio.SimpleAction.new("back", None)
        self.back.connect("activate", lambda *_a: self.go_back())
        self.back.set_enabled(False)
        self.add_action(self.back)
        self.set_accels_for_action("app.back", ["<Alt>Left", "Escape"])
        self.worker = Worker()
        self.vault = Vault(APP_ID, FOLDER, label="Почта")
        self.config = read_config()
        self.outbox = Outbox(OUTBOX)
        self.waiting = False     # held while «Исходящие» are not empty
        self.flushing = False
        self.flush_again = False
        self.live = True         # False after «Выйти», until the next sign-in
        self.set_inactivity_timeout(10000)
        Gio.NetworkMonitor.get_default().connect(
            "network-changed", lambda _m, up: up and self.flush())
        GLib.timeout_add_seconds(RETRY, lambda: self.flush() or True)
        self.flush()

    # Sending without a window (D-Bus) and «Исходящие»

    def do_dbus_register(self, connection, path):
        if not Gtk.Application.do_dbus_register(self, connection, path):
            return False
        interface = Gio.DBusNodeInfo.new_for_xml(DBUS).interfaces[0]
        self.dbus_ids.append((connection, connection.register_object(
            path, interface, self.dbus_call, None, None)))
        return True

    def do_dbus_unregister(self, connection, path):
        for conn, number in list(self.dbus_ids):
            if conn == connection:
                connection.unregister_object(number)
                self.dbus_ids.remove((conn, number))
        Gtk.Application.do_dbus_unregister(self, connection, path)

    def account(self):
        """(address, provider) of the saved mailbox, or None."""
        section = self.config["mail"]
        address = section.get("address", "")
        provider = servers.servers(address) or servers.from_field(section.get("imap", ""))
        return (address, provider) if address and provider else None

    def dbus_call(self, _conn, _sender, _path, _interface, method, params, invocation):
        if method != "Send":
            invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)
            return
        to, subject, body, paths = params.unpack()
        configured = self.live and self.account() is not None
        if configured:
            try:
                if not self.vault.get(SECRET):
                    configured = False
            except Locked:
                pass   # the letter waits until the keyring opens
            except Exception as e:  # noqa: BLE001 - never the password
                invocation.return_dbus_error("org.freedesktop.DBus.Error.Failed",
                                             str(e) or type(e).__name__)
                return
        if not configured:
            invocation.return_value(GLib.Variant("(s)", ("not-configured",)))
            return
        self.hold()   # the service stays until it answers
        try:
            result = accept(self.outbox, True, to, subject, body, paths)
            invocation.return_value(GLib.Variant("(s)", (result,)))
            self.waiting_changed(len(self.outbox.names()))
        except ValueError as e:
            invocation.return_dbus_error("org.freedesktop.DBus.Error.InvalidArgs", str(e))
            return
        except Exception as e:  # noqa: BLE001 - a disk error: never the password
            invocation.return_dbus_error("org.freedesktop.DBus.Error.Failed",
                                         str(e) or type(e).__name__)
            return
        finally:
            self.release()
        self.flush()

    def send_outbox(self, address, password, provider):
        """The waiting letters, on the worker thread; each one sent gets a copy
        in «Отправленные»."""
        box = Mailbox(address, password, provider.imap, CACHE)
        try:
            self.outbox.flush(address, password, provider.smtp, keep=box.save_sent)
        finally:
            box.close()

    def flush(self):
        """Another try for «Исходящие»: on start, when the network changes and
        every 10 minutes, and after Send keeps a letter."""
        account = self.account()
        if not self.live or account is None:
            self.flush_again = False
            return
        if self.flushing:
            self.flush_again = True
            return
        self.flushing = True
        address, provider = account

        def work():
            if self.outbox.names():
                try:
                    password = self.vault.get(SECRET)
                except Locked:
                    password = None
                if password:
                    self.send_outbox(address, password, provider)
            return len(self.outbox.names())

        def done(waiting):
            self.flushing = False
            self.waiting_changed(waiting)
            if self.flush_again:
                self.flush_again = False
                self.flush()

        def failed(_e):
            self.flushing = False
            if self.flush_again:
                self.flush_again = False
                self.flush()

        self.worker.do(work, done, failed)

    def waiting_changed(self, waiting):
        """Holds the program (and the service) while letters wait."""
        if waiting and not self.waiting:
            self.hold()
        elif not waiting and self.waiting:
            self.release()
        self.waiting = bool(waiting)

    def do_activate(self):
        if self.window is None:
            self.build()
            self.start()
        self.window.present()


    def domain_changed(self):
        address = self.address.get_text()
        known = servers.servers(address)
        other = known is None and bool(servers.domain(address))
        for widget in (self.server_label, self.server):
            widget.set_visible(other)
        if other and not self.server.get_text():
            saved = self.config.get("mail", "imap", fallback="")
            self.server.set_text(saved or servers.guess_field(address))
        if known:
            self.hint.set_text(known.hint)
        else:
            self.hint.set_text(servers.OTHER_HINT if other else
                               "Почта пускает программы по паролю приложения: "
                               "его создают в настройках безопасности почты.")

    def check(self):
        address = self.address.get_text().strip()
        password = self.password.get_text().strip().replace(" ", "")
        if not servers.domain(address):
            self.signin_status.set_text("Введите адрес почты целиком, например ivan@yandex.ru.")
            return
        if not password:
            self.signin_status.set_text("Введите пароль приложения.")
            return
        provider = servers.servers(address) or servers.from_field(self.server.get_text())
        if provider is None:
            self.signin_status.set_text("Укажите сервер, например imap.example.org.")
            return
        self.check_btn.set_sensitive(False)
        self.signin_status.set_text("Проверяю…")
        box = Mailbox(address, password, provider.imap, CACHE)

        def work():
            box.check()
            self.vault.put(SECRET, password)
            return box

        def done(box):
            self.check_btn.set_sensitive(True)
            self.password.set_text("")
            self.signin_status.set_text("")
            section = self.config["mail"]
            section["address"] = address
            section["imap"] = "%s:%d" % provider.imap
            section["smtp"] = "%s:%d" % provider.smtp
            try:
                write_config(self.config)
            except OSError:
                pass
            self.opened(box)
            self.flush()

        def failed(e):
            self.check_btn.set_sensitive(True)
            self.signin_status.set_text(error_text(e))
            box.close()

        self.worker.do(work, done, failed)

    def start(self):
        """The saved mailbox, if the vault keeps its password; else signing in."""
        section = self.config["mail"]
        address, imap = section.get("address", ""), section.get("imap", "")
        provider = servers.servers(address) or servers.from_field(imap)
        if not address or provider is None:
            self.show("signin")
            return

        def failed(e):
            self.signin_status.set_text(error_text(e))
            self.show("signin")

        def done(password):
            if not password:
                self.show("signin")
                return
            self.opened(Mailbox(address, password, provider.imap, CACHE))

        self.worker.do(lambda: self.vault.get(SECRET), done, failed)

    def opened(self, box):
        self.box = box
        self.role = INBOX
        self.folder_buttons[INBOX].set_active(True)
        self.show("list")
        self.load(0)

    def sign_out(self):
        address = self.box.address if self.box else ""
        question = ("Выйти из почты %s? Пароль приложения будет удалён, письма на "
                    "сервере останутся." % address)
        if self.outbox.names():
            question += " Неотправленные письма будут удалены."
        if not dialogs.ask(self.window, question, "Выйти"):
            return
        box, self.box = self.box, None
        self.gen += 1
        self.clear_list()

        def work():
            if box is not None:
                box.close()
            self.vault.drop(SECRET)
            self.outbox.clear()
            safe = re.sub(r"[^\w.@-]", "_", address.lower())
            if safe:
                shutil.rmtree(os.path.join(CACHE, safe), ignore_errors=True)
            shutil.rmtree(os.path.join(CACHE, "files"), ignore_errors=True)

        def failed(e):
            self.waiting()
            dialogs.info(self.window, error_text(e))

        self.worker.do(work, lambda _r: self.waiting(), failed)
        self.signin_status.set_text("")
        self.show("signin")

    # The list

    def build_list(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        folders = Gtk.Box(spacing=0, homogeneous=True)
        folders.get_style_context().add_class("folders")
        folders.get_style_context().add_class("linked")
        self.folder_buttons = {}
        group = None
        for role in (INBOX, SENT, TRASH):
            button = Gtk.RadioButton.new_with_label_from_widget(group, NAMES[role])
            button.set_mode(False)
            button.connect("toggled", self.folder_toggled, role)
            group = group or button
            self.folder_buttons[role] = button
            folders.pack_start(button, True, True, 0)
        page.pack_start(folders, False, False, 0)
        self.list_status = label("", "status", xalign=0.5, wrap=True)
        self.list_status.set_no_show_all(True)
        page.pack_start(self.list_status, False, False, 8)

        self.rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.rows.connect("row-activated", lambda _l, row: self.open_letter(row))
        self.placeholder = label("", "status", xalign=0.5)
        self.placeholder.show()
        self.rows.set_placeholder(self.placeholder)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        scroll.add(self.rows)
        scroll.connect("edge-reached", self.edge_reached)
        self.list_scroll = scroll
        page.pack_start(scroll, True, True, 0)
        return page

    def folder_toggled(self, button, role):
        if button.get_active() and role != self.role:
            self.role = role
            self.show("list")
            self.load(0)

    def clear_list(self):
        for row in self.rows.get_children():
            self.rows.remove(row)
        self.loaded = self.total = 0

    def set_status(self, text):
        self.list_status.set_text(text)
        self.list_status.set_visible(bool(text))

    def load(self, start):
        """The page from start on; start 0 reloads the folder (showing the
        cached lines first)."""
        if self.box is None or (self.loading and start):
            return
        box, role = self.box, self.role
        if start == 0:
            self.gen += 1
            self.clear_list()
            self.placeholder.set_text("Загружаю…")
            self.set_status("")
            gen = self.gen
            self.worker.do(lambda: box.cached(role, PAGE),
                           lambda lines: self.cached(gen, lines))
        gen = self.gen
        self.loading = True
        self.worker.do(lambda: box.page(role, start, PAGE),
                       lambda answer: self.loaded_page(gen, start, *answer),
                       lambda e: self.load_failed(gen, e))

    def cached(self, gen, lines):
        if gen == self.gen and not self.rows.get_children():
            for line in lines:
                self.rows.add(Row(line))
            self.rows.show_all()

    def loaded_page(self, gen, start, lines, total):
        if gen != self.gen:
            return
        self.loading = False
        if start == 0:
            self.clear_list()
        for line in lines:
            self.rows.add(Row(line))
        self.rows.show_all()
        self.loaded, self.total = start + len(lines), total
        self.placeholder.set_text("Писем нет")
        self.set_status("")

    def load_failed(self, gen, e):
        if gen != self.gen:
            return
        self.loading = False
        if isinstance(e, LoginFailed):
            self.box = None
            self.signin_status.set_text(
                "Почта больше не принимает пароль. Введите новый пароль приложения.")
            self.show("signin")
            return
        self.placeholder.set_text("")
        self.set_status(error_text(e) + " Нажмите «⟳», чтобы попробовать снова.")

    def edge_reached(self, _scroll, position):
        if position == Gtk.PositionType.BOTTOM and self.loaded < self.total:
            self.load(self.loaded)


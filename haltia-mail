                       self.text):
            column.pack_start(widget, False, False, 0)
        column.pack_start(self.trash_btn, False, False, 16)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.add(column)
        self.letter_scroll = scroll
        return scroll

    def open_letter(self, row):
        uid, role, box = row.line.uid, self.role, self.box
        if box is None:
            return
        self.letter_uid = uid
        self.letter = None
        self.letter_subject.set_text(row.line.subject)
        self.letter_from.set_text(row.line.sender)
        self.letter_when.set_text(nice_when(row.line.when, full=True))
        for child in self.files.get_children():
            self.files.remove(child)
        self.text.get_buffer().set_text("Открываю…")
        self.trash_btn.set_visible(False)
        self.letter_scroll.get_vadjustment().set_value(0)
        self.show("letter")

        def done(letter):
            row.set_unread(False)
            if self.letter_uid == uid:
                self.show_letter(letter, role)

        def failed(e):
            if self.letter_uid == uid:
                self.text.get_buffer().set_text(error_text(e))

        self.worker.do(lambda: box.read(role, uid), done, failed)

    def show_letter(self, letter, role):
        self.letter = letter
        self.letter_subject.set_text(letter.subject)
        head = letter.sender
        if role == SENT and letter.to:
            head = "Кому: " + letter.to
        self.letter_from.set_text(head)
        if letter.when:
            self.letter_when.set_text(nice_when(letter.when, full=True))
        for attachment in letter.attachments:
            self.files.pack_start(self.file_row(attachment), False, False, 0)
        self.files.show_all()
        buffer = self.text.get_buffer()
        buffer.set_text(letter.text or "(письмо без текста)")
        for match in LINK.finditer(letter.text):
            end = match.end() - len(match.group(0)) + len(match.group(0).rstrip(".,;:!?'"))
            buffer.apply_tag(self.link_tag, buffer.get_iter_at_offset(match.start()),
                             buffer.get_iter_at_offset(end))
        self.trash_btn.set_visible(role != TRASH)

    def text_tapped(self, view, event):
        buffer = view.get_buffer()
        if buffer.get_has_selection():
            return False
        x, y = view.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, int(event.x), int(event.y))
        found, where = view.get_iter_at_location(x, y)
        if not found or not where.has_tag(self.link_tag):
            return False
        start, end = where.copy(), where.copy()
        if not start.starts_tag(self.link_tag):
            start.backward_to_tag_toggle(self.link_tag)
        end.forward_to_tag_toggle(self.link_tag)
        uri = buffer.get_text(start, end, False)
        try:
            Gtk.show_uri_on_window(self.window, uri, Gdk.CURRENT_TIME)
        except GLib.Error:
            dialogs.info(self.window, "Не удалось открыть ссылку.")
        return False

    def file_row(self, attachment):
        row = Gtk.Box(spacing=12)
        name = label("%s · %s" % (attachment.name, nice_size(attachment.size)),
                     ellipsize=True)
        name.set_hexpand(True)
        row.pack_start(name, True, True, 0)
        for title, action in (("Открыть", self.open_file), ("Сохранить", self.save_file),
                              ("Отправить", self.send_file)):
            button = Gtk.Button(label=title)
            button.connect("clicked", lambda _b, act=action: act(attachment))
            row.pack_start(button, False, False, 0)
        return row

    def temp_file(self, attachment):
        """The attachment as a file of its own folder (only we can read it), so
        attachments with the same name do not meet."""
        folder = os.path.join(CACHE, "files")
        os.makedirs(folder, mode=0o700, exist_ok=True)
        folder = tempfile.mkdtemp(dir=folder)
        path = os.path.join(folder, attachment.name)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(attachment.data)
        return path

    def open_file(self, attachment):
        try:
            path = self.temp_file(attachment)
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(path).get_uri(), None)
        except (OSError, GLib.Error):
            dialogs.info(self.window, "Нет программы, которая открывает такие файлы.")

    def save_file(self, attachment):
        folder = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) \
            or GLib.get_home_dir()
        try:
            os.makedirs(folder, exist_ok=True)
            path = unique(folder, attachment.name)
            with open(path, "xb") as f:
                f.write(attachment.data)
        except OSError:
            dialogs.info(self.window, "Не удалось сохранить файл.")
            return
        dialogs.info(self.window, "Файл «%s» сохранён в папке «%s»."
                     % (os.path.basename(path), os.path.basename(folder)))

    def send_file(self, attachment):
        try:
            path = self.temp_file(attachment)
        except OSError:
            dialogs.info(self.window, "Не удалось подготовить файл.")
            return
        share.send(path, self.window)

    def to_trash(self):
        uid, role, box = self.letter_uid, self.role, self.box
        if box is None or uid is None or role == TRASH:
            return
        self.trash_btn.set_sensitive(False)

        def done(_result):
            self.trash_btn.set_sensitive(True)
            for row in self.rows.get_children():
                if row.line.uid == uid:
                    self.rows.remove(row)
                    self.loaded -= 1
                    self.total -= 1
            if self.letter_uid == uid:
                self.go_back()

        def failed(e):
            self.trash_btn.set_sensitive(True)
            dialogs.info(self.window, error_text(e))

        self.worker.do(lambda: box.trash(role, uid), done, failed)

    # Sending: the D-Bus method Send and «Исходящие», with or without a window

    def account(self):
        """(address, provider) of the saved mailbox, or None."""
        section = read_config()["mail"]
        address = section.get("address", "")
        provider = servers.servers(address) or servers.from_field(section.get("imap", ""))
        return (address, provider) if address and provider else None

    def deliver(self, account, password):
        """In the worker: «Исходящие» to SMTP -> {name: SENT or REFUSED}; what
        did not go stays for the next try."""
        if not password:
            return {}
        address, provider = account
        sender = outbox.Sender(address, password, provider.smtp)
        try:
            done, _error = self.outbox.flush(sender.send)
        finally:
            sender.close()
        return done

    def flush(self):
        """One try to send «Исходящие»."""
        account = self.account()
        if account is None or self.flushing or not self.outbox.names():
            self.waiting()
            return

        def done(_result):
            self.flushing = False
            self.waiting()

        self.flushing = True
        self.worker.do(lambda: self.deliver(account, self.vault.get(SECRET)), done, done)

    def waiting(self):
        """While letters wait, Почта keeps running (also without a window) and
        tries again every RETRY seconds and when the network comes back."""
        letters = bool(self.outbox.names())
        if letters and self.retry is None:
            self.hold()
            self.retry = GLib.timeout_add_seconds(RETRY, lambda: self.flush() or True)
        elif not letters and self.retry is not None:
            GLib.source_remove(self.retry)
            self.retry = None
            self.release()

    def dbus_call(self, _connection, _sender, _path, _interface, method, parameters,
                  invocation):
        if method != "Send":
            invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod",
                                         "No method %s" % method)
            return
        to, subject, body, attachments = parameters.unpack()
        account = self.account()
        if account is None:
            invocation.return_value(GLib.Variant("(s)", (NOT_CONFIGURED,)))
            return
        pending = [invocation]

        def answer(result=None, error=None, text=""):
            if not pending:
                return
            call = pending.pop()
            if error:
                call.return_dbus_error(error, text)
            else:
                call.return_value(GLib.Variant("(s)", (result,)))

        def late():
            answer(QUEUED)
            return False

        timer = GLib.timeout_add_seconds(ANSWER_WITHIN, late)
        self.hold()

        def work():
            letter = outbox.compose(account[0], to, subject, body, attachments)
            try:
                password = self.vault.get(SECRET)
            except Locked:
                password = None   # kept until the keyring opens
            else:
                if not password:
                    return NOT_CONFIGURED
            name = self.outbox.put(letter)
            return self.deliver(account, password).get(name, QUEUED)

        def finish():
            if pending:
                GLib.source_remove(timer)
            self.release()
            self.waiting()

        def done(result):
            finish()
            if result == outbox.REFUSED:
                answer(error="io.github.haltia_de.Mail.Error.Refused",
                       text="The mail server refused the letter.")
            else:
                answer(result)

        def failed(e):
            finish()
            if isinstance(e, ValueError):
                answer(error="org.freedesktop.DBus.Error.InvalidArgs", text=str(e))
            else:
                answer(error="org.freedesktop.DBus.Error.Failed",
                       text="Cannot keep the letter in the outbox.")

        self.worker.do(work, done, failed)



# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-mail
pkgver=0.1.1
pkgrel=0
pkgdesc="Почта: one mailbox, big letters (GTK 3)"
url="https://github.com/haltia-de/mail"
arch="noarch"
license="GPL-2.0-or-later"
depends="python3 py3-gobject3 gtk+3.0 py3-haltia-kit>=2.3.0"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/mail/archive/v$pkgver.tar.gz"
builddir="$srcdir/mail-$pkgver"

options="!check"

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
